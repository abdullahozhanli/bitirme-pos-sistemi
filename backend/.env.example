# En az 32 karakter rastgele (örnek DEĞİL — kendi değerinizi üretin)
JWT_SECRET=

PORT=5001
NODE_ENV=development

# Admin panel / CORS
FRONTEND_ORIGIN=http://localhost:5173

# Kalori tahmini (opsiyonel; yoksa yerel parser / USDA)
OPENAI_API_KEY=
USDA_API_KEY=
