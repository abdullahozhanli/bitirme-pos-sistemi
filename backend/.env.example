# MongoDB (Atlas önerilir; 0.0.0.0/0 açmayın, sadece sunucu IP'si)
MONGO_URI=mongodb://localhost:27017/bitirme

# En az 32 karakter rastgele (örnek DEĞİL — kendi değerinizi üretin)
JWT_SECRET=

PORT=5001
NODE_ENV=development

# Admin panel / CORS
FRONTEND_ORIGIN=http://localhost:5173

# Müşteri kaydı (mobil). Production'da false yapın.
ALLOW_PUBLIC_REGISTER=true

# Geliştirme: sahte online ödeme (production'da asla true yapmayın)
# ALLOW_DEMO_ONLINE_PAYMENT=true

# Bootstrap scriptleri (repoya yazmayın)
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# KASA_EMAIL=
# KASA_PASSWORD=
# GARSON_EMAIL=
# GARSON_PASSWORD=

# Kalori tahmini (opsiyonel; yoksa yerel parser / USDA)
# Admin ürün besin tahmini: GEMINI öncelikli, yoksa OPENAI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
USDA_API_KEY=
