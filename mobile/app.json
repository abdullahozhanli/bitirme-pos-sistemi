{
  "expo": {
    "name": "Self Kasa",
    "slug": "self-kasa-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/görsel/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selfkasa.mobile"
    },
    "android": {
      "package": "com.selfkasa.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./src/görsel/logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Masadaki QR kodu okutmak için kamera erişimi gerekir."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafını seçmek için galeri erişimi gerekir.",
          "cameraPermission": "Profil fotoğrafı çekmek için kamera erişimi gerekir."
        }
      ]
    ]
  }
}
